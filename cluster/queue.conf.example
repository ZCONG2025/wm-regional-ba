# Site-specific Sun Grid Engine settings, read by cluster/submit_array.sh.
#
#   cp cluster/queue.conf.example cluster/queue.conf   and edit.
#
# cluster/queue.conf is git-ignored: queue names and host lists mean nothing
# outside your own cluster, and the original version of this pipeline leaked
# ~250 internal hostnames by hard-coding them into the submit script.

# Queue to submit to. Leave empty to let SGE choose.
WMBA_QUEUE=""

# Anything else to pass to qsub. Resource requests belong here.
#
# Sizing notes for this pipeline:
#   - the Laplace solve holds several float64 volumes of the conformed image
#     (256^3), so ~8-16 GB of RAM per task is a safe request
#   - every stage is single-threaded; asking for more slots buys nothing
#   - a whole subject can take ~24 h on one core, so set h_rt generously or
#     submit the stages as separate jobs
WMBA_QSUB_EXTRA="-l h_vmem=16G -l h_rt=48:00:00"
