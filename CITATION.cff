cff-version: 1.2.0
title: "WM-RegionalBA: Laplacian white-matter mid-surfaces for regional white-matter brain age"
message: "If you use this software, please cite both the software and the paper below."
type: software
authors:
  - family-names: Zang
    given-names: Cong
    orcid: "https://orcid.org/0009-0008-9545-211X"
    affiliation: "University of Southern California"
repository-code: "https://github.com/ZCONG2025/wm-regional-ba"
license: GPL-3.0-only
version: "1.0.0"
keywords:
  - neuroimaging
  - white matter
  - brain age
  - FLAIR
  - FreeSurfer
  - surface registration

